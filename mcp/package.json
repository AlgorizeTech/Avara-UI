{
  "name": "algorize-ui-mcp",
  "version": "0.1.0",
  "description": "MCP server for Algorize UI — lets AI coding agents search, inspect, validate and install Algorize UI components from the live ShadCN registry.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "algorize-ui-mcp": "dist/entry/stdio.js"
  },
  "files": [
    "dist",
    "SKILL.md"
  ],
  "scripts": {
    "dev": "tsx watch src/entry/stdio.ts",
    "dev:http": "tsx watch src/entry/http.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/entry/http.js",
    "pretest": "npm run build",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/entry/stdio.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "tsx": "^4.19.4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  }
}
