{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/llm",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    }
  ],
  "rewrites": [
    {
      "source": "/r/v0-themed/:component/:example/item.json",
      "destination": "/api/v0?item=:component/:example"
    }
  ]
}
