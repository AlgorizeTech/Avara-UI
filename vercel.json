{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/r/v0-themed/:component/:example/item.json",
      "destination": "/api/v0?item=:component/:example"
    }
  ]
}
