{
  "name": "Algorize UI",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "tsx ./src/scripts/build-md-files.ts && npm run build:registry && npm run check:frameworks && next build",
    "build:analyze": "set ANALYZE=true && next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next build",
    "build:registry": "npm run generate:registry && shadcn build",
    "build:md": "tsx ./src/scripts/build-md-files.ts",
    "generate:preview": "tsx ./src/scripts/generate-preview-registry.ts",
    "generate:components": "tsx ./src/scripts/auto-generate-components.ts",
    "watch:components": "tsx ./src/scripts/watch-components.ts",
    "perf:audit": "npx lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html",
    "perf:bundle": "npx bundle-analyzer .next/static/chunks/*.js",
    "perf:optimize": "node scripts/optimize-build.js",
    "generate:registry": "tsx ./src/scripts/generate-registry.ts",
    "check:registry": "tsx ./src/scripts/check-registry.ts",
    "check:frameworks": "tsx ./src/scripts/check-frameworks.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "verify:registry": "node scripts/verify-registry.mjs"
  },
  "dependencies": {
    "@babel/generator": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.1",
    "@hookform/resolvers": "^5.2.2",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.3.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tabs": "^1.1.11",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "commander": "^14.0.0",
    "framer-motion": "^12.19.1",
    "geist": "^1.4.2",
    "glob": "^10.4.5",
    "gsap": "^3.14.2",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.510.0",
    "motion": "^12.11.3",
    "next": "^15.5.15",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "prismjs": "^1.30.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.73.1",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-live": "^4.1.8",
    "react-markdown": "^10.1.0",
    "react-responsive": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "shiki": "^3.4.0",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.3.1",
    "tinycolor2": "^1.6.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.4.5",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.20.7",
    "@types/glob": "^8.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19",
    "@types/tinycolor2": "^1.4.6",
    "eslint": "^9",
    "eslint-config-next": "^15.5.15",
    "prettier": "^3.6.2",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
